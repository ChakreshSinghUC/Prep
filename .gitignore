# Ignore object files, binaries, and other build artifacts
*.o
*.obj
*.exe
*.out
*.app
*.lib
*.a
*.so
*.dll
*.dylib

# Ignore build directories
/build/
/bin/
/Debug/
/Release/

# Ignore CMake build files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore IDE specific files
.vscode/
.idea/
*.code-workspace

# Ignore logs and temporary files
*.log
*.tmp
*.swp
*.swo
*.bak

# Ignore compiled Python files
__pycache__/
*.py[cod]

# Ignore other system files
.DS_Store
Thumbs.db

.history/